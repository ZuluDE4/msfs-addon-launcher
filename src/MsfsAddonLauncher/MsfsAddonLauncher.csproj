<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms wird nur fuer das Tray-Icon (NotifyIcon) gebraucht. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MsfsAddonLauncher</RootNamespace>
    <AssemblyName>MSFS Addon Launcher</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.9.1</Version>
    <Product>MSFS Addon Launcher</Product>
    <Description>Startet Zusatzprogramme und den Microsoft Flight Simulator 2024 mit einem Klick.</Description>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
    <!-- WPF0001: Application.ThemeMode (dunkles Fluent-Design) ist noch als experimentell markiert. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <!-- Einstellungen fuer "dotnet publish": eine einzelne .exe, die ihre Laufzeit mitbringt. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Verhindert Namenskonflikte zwischen WPF und Windows Forms (Application, Button, MessageBox ...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- WPF-Projekte bekommen System.IO nicht automatisch. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
