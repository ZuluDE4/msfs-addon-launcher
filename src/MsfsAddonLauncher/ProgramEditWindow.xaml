<Window x:Class="MsfsAddonLauncher.ProgramEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Programm" Width="720" SizeToContent="Height" MaxHeight="860"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Style="{StaticResource Beschriftung}" />
            <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Pfad" Style="{StaticResource Beschriftung}" />
            <TextBox x:Name="PfadBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" />
            <Button Grid.Row="1" Grid.Column="2" Content="Durchsuchen …" Click="Durchsuchen_Click" Margin="8,0,0,10" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Argumente" Style="{StaticResource Beschriftung}" />
            <TextBox x:Name="ArgumenteBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Arbeitsverzeichnis" Style="{StaticResource Beschriftung}" VerticalAlignment="Top" Margin="0,8,12,0" />
            <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10">
                <TextBox x:Name="ArbeitBox" />
                <TextBlock Style="{StaticResource Hinweis}" Text="Leer lassen = Ordner der Programmdatei." />
            </StackPanel>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Starten" Style="{StaticResource Beschriftung}" />
            <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10">
                <ComboBox x:Name="StartBox" HorizontalAlignment="Left" Width="330">
                    <ComboBoxItem Content="vor dem Sim" />
                    <ComboBoxItem Content="nach dem Sim (braucht Sim-Verbindung)" />
                </ComboBox>
            </StackPanel>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Verzögerung (Sekunden)" Style="{StaticResource Beschriftung}" VerticalAlignment="Top" Margin="0,8,12,0" />
            <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10">
                <TextBox x:Name="VerzoegerungBox" HorizontalAlignment="Left" Width="110" />
                <TextBlock Style="{StaticResource Hinweis}"
                           Text="Wartezeit direkt vor dem Start dieses Programms. Erhöhen, wenn es zu früh startet." />
            </StackPanel>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Optionen" Style="{StaticResource Beschriftung}" VerticalAlignment="Top" Margin="0,6,12,0" />
            <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10">
                <CheckBox x:Name="AktivBox" Content="Aktiv (aus = wird in keinem Profil gestartet)" />
                <CheckBox x:Name="AdminBox" Content="Als Administrator starten (Windows fragt jedes Mal nach)" />
                <CheckBox x:Name="MinimiertBox" Content="Minimiert starten (nicht jedes Programm hält sich daran)" />
                <CheckBox x:Name="SchliessenBox" Content="Beim Sim-Ende schließen" />
            </StackPanel>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Prozessname" Style="{StaticResource Beschriftung}" VerticalAlignment="Top" Margin="0,8,12,0" />
            <StackPanel Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10">
                <TextBox x:Name="ProzessBox" />
                <TextBlock Style="{StaticResource Hinweis}"
                           Text="Leer lassen = Dateiname aus dem Pfad. Nur nötig, wenn ein Updater vorgeschaltet ist und das eigentliche Programm anders heißt. Mehrere Namen mit ; trennen. Nachsehen: Task-Manager, Reiter „Details“." />
            </StackPanel>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Prozess-Pfadfilter" Style="{StaticResource Beschriftung}" VerticalAlignment="Top" Margin="0,8,12,0" />
            <StackPanel Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10">
                <TextBox x:Name="FilterBox" />
                <TextBlock Style="{StaticResource Hinweis}"
                           Text="Optional. Der Prozess zählt nur, wenn sein Dateipfad diesen Text enthält. Nötig bei Allerweltsnamen wie node.exe, damit kein fremdes Programm erkannt oder geschlossen wird." />
            </StackPanel>

            <TextBlock Grid.Row="9" Grid.Column="0" Text="Notiz" Style="{StaticResource Beschriftung}" />
            <TextBox x:Name="NotizBox" Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10" />

            <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Speichern" IsDefault="True" Click="Ok_Click" MinWidth="110"
                        Style="{DynamicResource AccentButtonStyle}" />
                <Button Content="Abbrechen" IsCancel="True" MinWidth="110" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
